# Copy this file to .env and fill in what you use. .env is never committed.

# Which broker the agent reads and sends through: alpaca or robinhood
BROKER=alpaca

# --- Alpaca (https://alpaca.markets). Paper keys are free and move no real money.
ALPACA_KEY=
ALPACA_SECRET=
# Leave 0 for paper trading. 1 sends orders to a LIVE Alpaca account with real money.
ALPACA_LIVE=0

# --- Robinhood needs no key here. Run:  python3 -m wheel.agent connect

# --- The master switch. 0: approved orders wait in the outbox and nothing leaves this machine.
#     1: `python3 -m wheel.agent send` passes approved orders to the broker.
WHEEL_SEND=0

# --- Dashboard access. Leave both empty to run on your own computer only (127.0.0.1).
#     On a server, set a long random token; the dashboard refuses to start without one.
WHEEL_HOST=
WHEEL_TOKEN=

# --- Telegram (optional): proposals with Approve / Decline buttons on your phone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Research only: the SEC asks automated readers to say who they are.
#     Put your name and a contact address here.
SEC_CONTACT=
